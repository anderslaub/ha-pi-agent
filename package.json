{
  "name": "pi-va-bridge",
  "version": "0.4.0",
  "description": "Use pi as the brain of Home Assistant assistants: the bridge for the 'Pi Agent' Home Assistant integration",
  "keywords": [
    "pi-package",
    "home-assistant",
    "assist",
    "voice-assistant"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anderslaub/ha-pi-agent"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bridge/src",
    "bridge/systemd",
    "README.md",
    "LICENSE"
