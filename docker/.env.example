# Required: shared secret with Home Assistant (openssl rand -hex 24)
PI_BRIDGE_TOKEN=
# Host user that owns the workspace files (id -u / id -g)
PUID=1000
PGID=1000
# Port on the host (inside the container the bridge always uses 8787)
PI_BRIDGE_PORT=8787
# Folder on the host that becomes the assistant's working folder
WORKSPACE=./workspace

# Model: provider/model[:thinking]. Empty = the default model you pick in pi (/model), else the provider's
# default. List the names: docker compose exec va-bridge pi --list-models
# Changes to .env apply with "docker compose up -d" (a restart does not re-read it).
# PI_BRIDGE_MODEL=anthropic/claude-sonnet-5-5
# PI_BRIDGE_THINKING=low
# Restrict tools (comma separated). Empty = pi's defaults incl. bash, edit, write.
# PI_BRIDGE_TOOLS=read,grep,find,ls,web_search

# pi packages to install on first start (space separated). Their npm install scripts are allowed to run.
# PI_PACKAGES=npm:pi-web-access
# Other npm packages whose install scripts may run, comma separated (npm 12 blocks them by default)
# PI_ALLOW_SCRIPTS=sharp

# Local llama.cpp router (llama serve without -m). The bridge lists the router's loaded models; pick one
# with PI_BRIDGE_MODEL=llama.cpp/<model id>, or leave that empty to use the first available.
# On the Docker host itself: http://host.docker.internal:<port> (localhost is the container)
# LLAMA_BASE_URL=http://host.docker.internal:8080
# LLAMA_API_KEY=

# Provider credentials (any variable pi understands), or log in once instead (kept in the pi-agent volume):
#   docker compose exec va-bridge pi    then /login, and /model to pick the default model
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# pi version for the image build. Default: latest
# PI_VERSION=latest

TZ=UTC
